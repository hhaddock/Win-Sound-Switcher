<Window x:Class="SoundSwitcher.Overlay.SwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Switcher"
        Width="420"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True"
        KeyDown="Window_KeyDown">
    <Border Margin="12"
            Padding="16"
            Background="#F5262A31"
            BorderBrush="#FF6E7A87"
            BorderThickness="1"
            CornerRadius="12">
        <StackPanel>
            <TextBlock Margin="0,0,0,10"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="Sound output" />
            <ListBox x:Name="DeviceList"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     MouseDoubleClick="DeviceList_MouseDoubleClick"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF3D7ACC" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="BorderBrush" Value="#FF70D6A4" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="15"
                                       Text="{Binding Label}" />
                            <TextBlock Grid.Column="1"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#FFD7DEE8"
                                       Text="{Binding StatusText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Margin="0,12,0,0"
                       Foreground="#FFD7DEE8"
                       Text="Enter or double-click to switch · Escape to close" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#FFFFD27D"
                       Text="Unavailable devices can be replaced in Configure devices." />
        </StackPanel>
    </Border>
</Window>
